# Supabase
# Get these from your Supabase project settings: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key
EMAIL_FROM="Cozy Cloud <onboarding@resend.dev>"

# Admin
# The email address allowed to access /admin (must also exist as a Supabase Auth user)
ADMIN_EMAIL=you@example.com

# Site URL (no trailing slash)
# Use http://localhost:3000 for local dev, your Vercel URL in production
NEXT_PUBLIC_SITE_URL=http://localhost:3000
